graph LR
    subgraph repo["🐙 GitHub — puBILYYEN/kyoto-map（main）"]
        direction TB
        front["根目錄<br/>index.html · app.js<br/>data.js · styles.css · sw.js"]
        be["ai-backend/<br/>server.js · package.json"]
        vi[".vercelignore<br/>排除 ai-backend/"]
        ry["render.yaml<br/>rootDir: ai-backend"]
