    push(["git push"]) --> repo

    repo -->|"webhook 自動部署<br/>根目錄無 package.json<br/>→ 當作靜態網站"| vercel["☁️ Vercel<br/>kyoto-trip-map.vercel.app"]
    repo -->|"Blueprint 讀 render.yaml<br/>autoDeploy 關閉<br/>→ 需手動 Deploy"| render["🔧 Render<br/>kyoto-ai.onrender.com"]

    vi -.->|"讓 Vercel 看不到後端"| vercel
    ry -.->|"指定子目錄"| render
    front --> vercel
    be --> render

